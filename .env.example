# Get your API key from https://platform.openai.com/api-keys
# Note: OpenAI's image API has no free tier; the account needs billing credit.
OPENAI_API_KEY=your_api_key_here

# Optional: override the models used per tier (defaults shown).
# Economy is the default; premium is only used with --paid --confirm-paid.
# OPENAI_IMAGE_MODEL_ECONOMY=gpt-image-1-mini
# OPENAI_IMAGE_MODEL_PREMIUM=gpt-image-1
